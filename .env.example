# Discord OAuth (создай приложение на https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Необязательно. Пусто = redirect из адреса сайта. Продакшен: https://домен/api/auth/callback
DISCORD_REDIRECT_URI=

# Bot token из SOLARBOT (.env) — для заявок, импорта, выдачи роли
DISCORD_BOT_TOKEN=

# Сессии сайта (случайная строка 32+ символов)
SESSION_SECRET=change-me-to-random-string

# SOLARDS plugin API — укажи точный URL из config плагина на сервере
# Пример: http://26.13.227.132:8080/status
SOLARDS_API_URL=
SOLARDS_PORT=8080

# Minecraft server (fallback если SOLARDS недоступен)
MINECRAFT_SERVER_IP=26.13.227.132
MINECRAFT_SERVER_PORT=25813
# Папка сервера (world/advancements + usercache.json) для достижений на сайте
# MINECRAFT_SERVER_PATH=C:\path\to\server
# Или отдельно:
# MINECRAFT_ADVANCEMENTS_DIR=
# MINECRAFT_USERCACHE=
# MINECRAFT_DATAPACKS_DIR=
# SPSOLARDS_DB=  # plugins/SPSolards/data.db — discord ↔ uuid

# BlueMap / онлайн-карта (проксируется через /bluemap/)
# Если карта на другом URL — укажи здесь
MAP_UPSTREAM=http://26.13.227.132:8100
NEXT_PUBLIC_MAP_URL=http://26.13.227.132:8100

# SOLARDS plugin API (привязки /dslink, статус)
SOLARDS_API_URL=http://26.13.227.132:8080
SOLARDS_PORT=8080
SOLARDS_API_TOKEN=solarmc-web-api-change-me

# Discord IDs (из SOLARBOT + SOLARDS config)
DISCORD_GUILD_ID=1466351394523971620
DISCORD_MODERATOR_ROLE_ID=1480602248831696987
DISCORD_ADMIN_ROLE_ID=1466352163398619293
DISCORD_STAFF_ROLE_ID=1480602248831696987
DISCORD_APPROVED_ROLE_ID=1466352891932577926
DISCORD_APPLICATION_CATEGORY_ID=1487428372220088452
# Категория для каналов тикетов поддержки (web-support-N)
DISCORD_SUPPORT_CATEGORY_ID=1487647069416980531
DISCORD_HELP_CHANNEL_ID=1487647305594306661

# Секрет для кнопок Discord → сайт (SOLARBOT шлёт в /api/support/discord-action)
DISCORD_BOT_ACTION_SECRET=change-me-bot-action-secret
# URL сайта для SOLARBOT (опционально)
# SITE_URL=http://localhost:3000

# Солнышко (помощник на сайте). Без ключа работает бесплатно по вики.
# Опционально бесплатный ключ Google AI Studio: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Стабильнее без обрезки: gemini-2.0-flash (по умолчанию в коде)
# GEMINI_MODEL=gemini-2.0-flash
